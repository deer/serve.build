<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>build.serve</groupId>
        <artifactId>serve-project</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>serve-example</artifactId>

    <name>Serve Example</name>

    <dependencies>
        <dependency>
            <groupId>build.serve</groupId>
            <artifactId>serve-application</artifactId>
        </dependency>
        <dependency>
            <groupId>build.serve</groupId>
            <artifactId>serve-transport-json</artifactId>
        </dependency>
        <dependency>
            <groupId>build.serve</groupId>
            <artifactId>serve-websocket</artifactId>
        </dependency>
        <dependency>
            <groupId>build.base</groupId>
            <artifactId>base-template</artifactId>
        </dependency>
        <dependency>
            <groupId>build.base</groupId>
            <artifactId>base-template-processor</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>build.serve</groupId>
            <artifactId>serve-htmx</artifactId>
        </dependency>
        <dependency>
            <groupId>build.serve</groupId>
            <artifactId>serve-cors</artifactId>
        </dependency>
        <dependency>
            <groupId>build.serve</groupId>
            <artifactId>serve-security</artifactId>
        </dependency>
        <dependency>
            <groupId>build.serve</groupId>
            <artifactId>serve-compression</artifactId>
        </dependency>
        <dependency>
            <groupId>build.serve</groupId>
            <artifactId>serve-logging</artifactId>
        </dependency>
        <dependency>
            <groupId>build.serve</groupId>
            <artifactId>serve-health</artifactId>
        </dependency>
        <dependency>
            <groupId>build.serve</groupId>
            <artifactId>serve-graphql</artifactId>
        </dependency>
        <dependency>
            <groupId>build.serve</groupId>
            <artifactId>serve-session</artifactId>
        </dependency>
        <dependency>
            <groupId>build.serve</groupId>
            <artifactId>serve-auth</artifactId>
        </dependency>
        <dependency>
            <groupId>build.serve</groupId>
            <artifactId>serve-ratelimit</artifactId>
        </dependency>
        <dependency>
            <groupId>build.serve</groupId>
            <artifactId>serve-devtools</artifactId>
        </dependency>
        <dependency>
            <groupId>build.serve</groupId>
            <artifactId>serve-foundation</artifactId>
        </dependency>
        <dependency>
            <groupId>build.serve</groupId>
            <artifactId>serve-form</artifactId>
        </dependency>

        <dependency>
            <groupId>build.base</groupId>
            <artifactId>base-network</artifactId>
        </dependency>

        <dependency>
            <groupId>build.base</groupId>
            <artifactId>base-json</artifactId>
        </dependency>


        <!-- Test -->
        <dependency>
            <groupId>build.serve</groupId>
            <artifactId>serve-testing</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <generatedSourcesDirectory>${project.build.directory}/generated-sources/jt</generatedSourcesDirectory>
                    <!-- Maven compiler plugin does not auto-route JPMS processor modules to processor-module-path.
                         Required until tooling (spin.build) handles this automatically. -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>build.base</groupId>
                            <artifactId>base-template-processor</artifactId>
                            <version>${base.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec-maven-plugin.version}</version>
                <configuration>
                    <executable>java</executable>
                    <arguments>
                        <argument>--add-opens=jdk.httpserver/sun.net.httpserver=ALL-UNNAMED</argument>
                        <argument>-classpath</argument>
                        <classpath/>
                        <argument>build.serve.example.ExampleApp</argument>
                    </arguments>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>--enable-preview --add-opens jdk.httpserver/sun.net.httpserver=build.serve.websocket
                    </argLine>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <configuration>
                    <!-- Dependencies required by module-info.java but not detected via bytecode analysis -->
                    <usedDependencies>
                        <usedDependency>build.serve:serve-htmx</usedDependency>
                    </usedDependencies>
                    <ignoredUnusedDeclaredDependencies>
                        <ignoredUnusedDeclaredDependency>build.base:base-template-processor</ignoredUnusedDeclaredDependency>
                    </ignoredUnusedDeclaredDependencies>
                </configuration>
            </plugin>
        </plugins>
    </build>


</project>
